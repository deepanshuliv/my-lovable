generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(uuid())

  ownerId   String
  name      String   @default("Untitled")
  template  String   @default("nextjs-fullstack")
  sandboxId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           Event[]
  snapshots        Snapshot[]
  secrets          Secret[]
  taskState        TaskState?
  summaries        SessionSummary[]
  toolOutputs      ToolOutput[]
  githubConnection GithubConnection?

  @@index([ownerId, updatedAt])
  @@map("projects")
}

model TaskState {
  taskId      String   @id
  projectId   String   @unique
  sessionId   String
  version     Int      @default(1)
  state       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([sessionId, updatedAt])
  @@map("task_states")
}

model SessionSummary {
  id                 String   @id @default(uuid())
  taskId             String
  sessionId          String
  version            Int
  summary            Json
  coversFromEventSeq Int?
  coversToEventSeq   Int?
  createdAt          DateTime @default(now())

  project Project @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([sessionId, version])
  @@map("session_summaries")
}

model ToolOutput {
  id          String   @id @default(uuid())
  taskId      String
  sessionId   String
  command     String?
  exitCode    Int?
  stdout      String
  stderr      String
  preview     String
  truncated   Boolean  @default(false)
  byteLength  Int      @default(0)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([sessionId, createdAt])
  @@map("tool_outputs")
}

model Event {
  id        String   @id @default(uuid())
  projectId String

  seq       Int
  type      String
  payload   Json

  streamId  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, streamId])
  @@index([projectId, seq])
  @@map("events")
}

model Snapshot {
  id        String   @id @default(uuid())
  projectId String

  r2Key     String

  upToSeq   Int
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, upToSeq])
  @@map("snapshots")
}

model Secret {
  id            String   @id @default(uuid())
  projectId     String

  key           String

  ciphertext    String
  iv            String
  authTag       String

  maskedPreview String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("secrets")
}

model UserProviderKey {
  id            String   @id @default(uuid())

  userId        String

  provider      String
  ciphertext    String
  iv            String
  authTag       String

  maskedPreview String

  model         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, provider])
  @@map("user_provider_keys")
}

model CreditAccount {
  userId        String   @id
  grantedMicros Int      @default(10000)
  consumedMicros Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ledger CreditLedger[]

  @@map("credit_accounts")
}

model CreditLedger {
  id           String   @id @default(uuid())
  userId       String
  requestId    String
  kind         String
  amountMicros Int
  provider     String?
  model        String?
  metadata     Json?
  createdAt    DateTime @default(now())

  account CreditAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, requestId, kind])
  @@index([userId, createdAt])
  @@map("credit_ledger")
}

model GithubConnection {
  id               String   @id @default(uuid())
  projectId        String   @unique
  repository       String
  branch           String
  prNumber         Int?
  prUrl            String?
  lastSyncedCommit String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}
