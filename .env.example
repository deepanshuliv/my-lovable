# Copy to .env and fill in. Nothing here has a real value committed.

# ── Model ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# MODEL= is legacy; GEMINI_MODEL below supersedes it.
MODEL=gemini-3.5-flash

# ── Model provider ────────────────────────────────────────────────────────────
# Whichever key is present decides the provider. If both are set, OpenRouter wins —
# adding that key is a deliberate act, while a Gemini key is often left over from setup.
# Force one with MODEL_PROVIDER=gemini|openrouter (default: auto).
MODEL_PROVIDER=auto

# OpenRouter — put your key here.
OPENROUTER_API_KEY=
# Cheapest model on OpenRouter that is genuinely capable of agentic tool-driven coding:
# ~$0.08 in / $0.17 out per 1M tokens, 1M context. Cheaper models exist but are small
# general-purpose ones that flail at multi-step tool use.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini model when the Gemini provider is selected. $0.25 / $1.50 per 1M, 1M context.
# gemini-2.5-flash-lite is cheaper ($0.10/$0.40) but Google retires it on 16 Oct 2026.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Daytona (sandboxes) ───────────────────────────────────────────────────────
DAYTONA_API_KEY=
# The port the generated app's dev server listens on inside the sandbox.
PREVIEW_PORT=3000
# Sandboxes are created public so their preview URL loads inside the builder's iframe.
# A private sandbox requires an access token on every request and an iframe cannot send
# headers, so the preview pane would show a 401. Setting this false trades the embedded
# preview away for a sandbox nobody can reach by URL alone.
SANDBOX_PUBLIC_PREVIEW=true

# ── Sandbox sizing ────────────────────────────────────────────────────────────
# Daytona's default is 1 GiB, which is too small: `npm install` on a Next.js dependency
# tree and `next build` are both OOM-killed at that size (exit 137), and an install killed
# halfway leaves a corrupt npm/npx cache that then breaks unrelated commands.
# `resources` is only honoured on image-based creation, hence SANDBOX_IMAGE.
SANDBOX_IMAGE=node:22-bookworm
SANDBOX_CPU=2
SANDBOX_MEMORY_GIB=4
SANDBOX_DISK_GIB=8

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=lovable
POSTGRES_PASSWORD=lovable
POSTGRES_DB=lovable
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lovable:lovable@localhost:5432/lovable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── Redis Iris (agent memory) ─────────────────────────────────────────────────
# Leave blank to run on the plain-Redis session fallback: session history still works
# exactly, long-term semantic recall is simply unavailable. Fill both in to switch over —
# no code change, no restart of anything but the backend.
REDIS_IRIS_URL=
REDIS_IRIS_API_KEY=
REDIS_IRIS_NAMESPACE=my-lovable
# TTL for session history in the fallback store (seconds).
SESSION_TTL_SECONDS=604800

# ── Cloudflare R2 (snapshots) ─────────────────────────────────────────────────
# Leave blank to disable snapshotting; projects then rebuild from the template and full
# event history instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; defaults to https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# ── Secrets encryption ────────────────────────────────────────────────────────
# 32 bytes, base64. Generate with:  openssl rand -base64 32
# Rotating this makes existing stored secrets undecryptable — users must re-enter them.
SECRETS_MASTER_KEY=

# ── Project template ──────────────────────────────────────────────────────────
# builtin  — upload templates/<TEMPLATE_NAME> from this repo (default, no setup needed)
# git      — shallow-clone TEMPLATE_GIT_URL at TEMPLATE_GIT_REF
# snapshot — create sandboxes from a pre-baked Daytona snapshot with node_modules already
#            installed. Fastest cold start. Build it with: bun scripts/bake-snapshot.ts
TEMPLATE_SOURCE=builtin
TEMPLATE_NAME=nextjs-fullstack
TEMPLATE_GIT_URL=
TEMPLATE_GIT_REF=main
TEMPLATE_SNAPSHOT=

# ── Ownership ─────────────────────────────────────────────────────────────────
# false (default): a reconnecting session takes over a project as soon as the previous
#   owner's SSE connection is provably gone, rather than waiting out the 30s lock TTL.
# true: never take over; always wait for the lock to expire.
STRICT_OWNERSHIP=false

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGIN=*

# ── Context compaction ────────────────────────────────────────────────────────
# Fraction of the context window at which old history is compacted into a structured
# summary (pi's format: Goal / Constraints / Progress / Key Decisions / Next Steps /
# Critical Context). If compaction is not enough, the whole conversation collapses into
# one summary instead.
COMPACT_AT_FRACTION=0.8
# Recent tokens kept verbatim after a compaction.
KEEP_RECENT_TOKENS=20000
# Ceiling on the generated summary, so compaction cannot create a new context problem.
SUMMARY_MAX_TOKENS=2000
# Context window per provider. Override if you switch to a model with a different size.
OPENROUTER_CONTEXT_WINDOW=1048576
GEMINI_CONTEXT_WINDOW=1000000
# The request invariant keeps this many tokens for the model response and an additional
# safety margin. For a deliberately tiny test harness, lower the model window and reserves
# together (the reserves must still leave room for mandatory context).
AGENT_RESPONSE_RESERVE=4096
AGENT_SAFETY_RESERVE=50000
# The live coordinator compacts before active-context utilization reaches this fraction once
# enough durable events exist. Provider-local compaction remains an additional guard.
AGENT_COMPACTION_FRACTION=0.72
AGENT_COMPACTION_MIN_EVENTS=12
# Raw stdout/stderr above this character count is stored in Postgres and only its bounded
# preview plus output_id is sent to the model.
TOOL_OUTPUT_INLINE_CHARS=12000

# ── Tuning ────────────────────────────────────────────────────────────────────
QUESTION_TIMEOUT_MS=600000
COMMAND_TIMEOUT_SECONDS=300
MAX_AGENT_TURNS=30
WORKER_BATCH_SIZE=100
WORKER_BLOCK_MS=5000
